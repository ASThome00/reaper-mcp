desc:MCP LUFS Meter
// ITU-R BS.1770 loudness meter for MCP bridge integration.
// Measures integrated, short-term, and momentary LUFS with true peak detection.
// Writes results to shared memory (gmem) so the Lua bridge can read them.
//
// gmem layout (per track slot, 8 slots each):
//   base = track_slot * 8
//   gmem[base+0] = integrated LUFS (BS.1770-4 gated: 400 ms blocks, 75% overlap,
//                  absolute -70 LUFS and relative -10 LU gates, since last reset)
//   gmem[base+1] = short-term LUFS (3-second sliding window)
//   gmem[base+2] = momentary LUFS (400ms sliding window)
//   gmem[base+3] = true peak L (dBTP, 4x polyphase windowed-sinc oversampling)
//   gmem[base+4] = true peak R (dBTP, 4x polyphase windowed-sinc oversampling)
//   gmem[base+5] = measurement duration (seconds since last reset)

options:gmem=MCPLufsMeter

slider1:reset_btn=0<0,1,1{Idle,Reset}>Reset Measurement
slider2:track_slot=0<0,127,1>Track Slot

@init
  // K-weighting filter state (two biquad stages per channel)
  // Stage 1: High-shelf pre-filter (+4 dB at 1681 Hz)
  // Stage 2: High-pass RLB filter (100 Hz, -12 dB/oct)
  hs_x1l = hs_x2l = hs_y1l = hs_y2l = 0;
  hs_x1r = hs_x2r = hs_y1r = hs_y2r = 0;
  hp_x1l = hp_x2l = hp_y1l = hp_y2l = 0;
  hp_x1r = hp_x2r = hp_y1r = hp_y2r = 0;

  // High-shelf filter coefficients (recomputed on init and sample rate change)
  hs_b0 = hs_b1 = hs_b2 = hs_a1 = hs_a2 = 0;
  hp_b0 = hp_b1 = hp_b2 = hp_a1 = hp_a2 = 0;

  // Ring buffer for per-sample squared weighted values (up to 3s)
  // momentary: 400ms window, short-term: 3s window
  buf_size = 0;
  buf_l = 65536;          // start address for left channel ring buffer
  buf_r = 327680;         // right ring buffer: past buf_l + max buf_size (262144), no overlap
  buf_pos = 0;

  // Running sums for windows
  momentary_sum_l = 0;
  momentary_sum_r = 0;
  shortterm_sum_l = 0;
  shortterm_sum_r = 0;
  // Gating (BS.1770-4 Annex 1): 100 ms sub-blocks, each 400 ms block = last 4.
  // Gated blocks go into a 0.01 LU histogram (-70..+30 LUFS) holding energy
  // sums and counts, so memory stays fixed for any measurement length.
  sub_e = 600200;         // last 4 sub-block energies (ring)
  hist_e = 610000;        // per-bin summed block energy
  hist_n = 620000;        // per-bin block count
  HIST_BINS = 10000;
  sub_len = 0;
  sub_acc = 0;
  sub_pos = 0;
  sub_idx = 0;
  sub_filled = 0;
  blocks_dirty = 0;
  integrated_lufs = -70;

  // True peak: 4x polyphase FIR over a 12-sample history per channel.
  // Phase p interpolates at fractional offset p/4; phase 0 is the sample itself.
  TP_TAPS = 12;
  tp_hist_l = 600000;
  tp_hist_r = 600016;
  tp_coef = 600100;       // 3 phases x 12 taps (phases 1..3)
  tp_hpos = 0;

  function compute_tp_coefs() local(p, k, t, w, sum) (
    p = 1;
    loop(3,
      sum = 0;
      k = 0;
      loop(TP_TAPS,
        // x[n-k] sits at t = k - 6 + p/4 from the interpolated point
        t = k - 6 + p / 4;
        w = 0.42 + 0.5 * cos($pi * t / 6) + 0.08 * cos(2 * $pi * t / 6); // Blackman
        tp_coef[(p - 1) * TP_TAPS + k] = (abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t)) * w;
        sum += tp_coef[(p - 1) * TP_TAPS + k];
        k += 1;
      );
      // Unity DC gain per phase
      k = 0;
      loop(TP_TAPS, tp_coef[(p - 1) * TP_TAPS + k] /= sum; k += 1; );
      p += 1;
    );
  );

  function compute_integrated() local(b, e, n, gate_bin) (
    // Pass 1: blocks above the absolute gate (all histogram bins)
    e = n = 0;
    b = 0;
    loop(HIST_BINS, e += hist_e[b]; n += hist_n[b]; b += 1; );
    n > 0 ? (
      // Relative gate: 10 LU below the absolute-gated loudness
      gate_bin = ceil((-0.691 + 10 * log10(e / n) - 10 + 70) * 100);
      gate_bin < 0 ? gate_bin = 0;
      e = n = 0;
      b = gate_bin;
      loop(max(HIST_BINS - gate_bin, 0), e += hist_e[b]; n += hist_n[b]; b += 1; );
      integrated_lufs = n > 0 ? -0.691 + 10 * log10(e / n) : -70;
    ) : (
      integrated_lufs = -70;
    );
  );

  // True peak hold
  true_peak_l = 0.000001;
  true_peak_r = 0.000001;

  // Measurement duration
  sample_count = 0;

  needs_init = 1;

  function compute_kweight_filters() (
    // High-shelf pre-filter: +4 dB shelf at f0 = 1681.974 Hz
    // From BS.1770-4, Annex 1, Table 1
    db = 3.99984385397;  // ~4 dB
    K = tan($pi * 1681.974 / srate);
    Vh = exp(db / 20 * log(10));
    Vb = Vh ^ 0.4996667741545416;
    a0 = 1 + K/0.7071067811865476 + K*K;
    hs_b0 = (Vh + Vb * K / 0.7071067811865476 + K*K) / a0;
    hs_b1 = 2 * (K*K - Vh) / a0;
    hs_b2 = (Vh - Vb * K / 0.7071067811865476 + K*K) / a0;
    hs_a1 = 2 * (K*K - 1) / a0;
    hs_a2 = (1 - K/0.7071067811865476 + K*K) / a0;

    // High-pass filter: 38.13547 Hz, Q = 0.5003270373238773
    K2 = tan($pi * 38.13547 / srate);
    a0 = K2*K2 + K2/0.5003270373238773 + 1;
    // Numerator stays [1, -2, 1] as in BS.1770 / libebur128; the -0.691 offset
    // is calibrated against it (997 Hz 0 dBFS on one channel = -3.01 LUFS)
    hp_b0 = 1;
    hp_b1 = -2;
    hp_b2 = 1;
    hp_a1 = 2 * (K2*K2 - 1) / a0;
    hp_a2 = (K2*K2 - K2/0.5003270373238773 + 1) / a0;
  );

  function reset_measurement() (
    base = floor(track_slot + 0.5) * 8;
    buf_pos = 0;
    momentary_sum_l = 0;
    momentary_sum_r = 0;
    shortterm_sum_l = 0;
    shortterm_sum_r = 0;
    sub_acc = 0;
    sub_pos = 0;
    sub_idx = 0;
    sub_filled = 0;
    blocks_dirty = 0;
    integrated_lufs = -70;
    memset(sub_e, 0, 4);
    memset(hist_e, 0, HIST_BINS);
    memset(hist_n, 0, HIST_BINS);
    true_peak_l = 0.000001;
    true_peak_r = 0.000001;
    sample_count = 0;
    // Filter and true-peak histories describe the live signal, so they are not
    // cleared: zeroing them fakes a step that rings (K-weighting transient,
    // sinc overshoot) when a reset lands mid-signal.
    // Clear ring buffers
    memset(buf_l, 0, buf_size);
    memset(buf_r, 0, buf_size);
    gmem[base+0] = -70;
    gmem[base+1] = -70;
    gmem[base+2] = -70;
    gmem[base+3] = -150;
    gmem[base+4] = -150;
    gmem[base+5] = 0;
  );

@slider
  // Re-compute filter coefficients (handles sample rate changes)
  needs_init = 1;

  // Handle reset button
  reset_btn >= 0.5 ? (
    reset_measurement();
    reset_btn = 0;
    sliderchange(reset_btn);
  );

@sample
  needs_init ? (
    compute_kweight_filters();
    compute_tp_coefs();
    sub_len = floor(srate * 0.1 + 0.5);
    // Buffer: 3 seconds at current sample rate
    buf_size = ceil(srate * 3.0);
    buf_size > 262144 ? buf_size = 262144; // safety cap (covers up to ~87kHz)
    reset_measurement();
    needs_init = 0;
  );

  // --- K-weighting: stage 1 (high-shelf) ---
  wl = spl0;
  wr = spl1;

  // High-shelf left
  kl = hs_b0 * wl + hs_b1 * hs_x1l + hs_b2 * hs_x2l - hs_a1 * hs_y1l - hs_a2 * hs_y2l;
  hs_x2l = hs_x1l; hs_x1l = wl; hs_y2l = hs_y1l; hs_y1l = kl;

  // High-shelf right
  kr = hs_b0 * wr + hs_b1 * hs_x1r + hs_b2 * hs_x2r - hs_a1 * hs_y1r - hs_a2 * hs_y2r;
  hs_x2r = hs_x1r; hs_x1r = wr; hs_y2r = hs_y1r; hs_y1r = kr;

  // --- K-weighting: stage 2 (high-pass) ---
  fl = hp_b0 * kl + hp_b1 * hp_x1l + hp_b2 * hp_x2l - hp_a1 * hp_y1l - hp_a2 * hp_y2l;
  hp_x2l = hp_x1l; hp_x1l = kl; hp_y2l = hp_y1l; hp_y1l = fl;

  fr = hp_b0 * kr + hp_b1 * hp_x1r + hp_b2 * hp_x2r - hp_a1 * hp_y1r - hp_a2 * hp_y2r;
  hp_x2r = hp_x1r; hp_x1r = kr; hp_y2r = hp_y1r; hp_y1r = fr;

  // Squared weighted samples
  sq_l = fl * fl;
  sq_r = fr * fr;

  // --- Ring buffer update ---
  old_l = buf_l[buf_pos];
  old_r = buf_r[buf_pos];

  // Short-term window is full 3s buffer
  shortterm_sum_l -= old_l;
  shortterm_sum_r -= old_r;

  // Momentary window: 400ms lag pointer
  mom_pos = buf_pos - floor(srate * 0.4);
  mom_pos < 0 ? mom_pos += buf_size;
  momentary_sum_l -= buf_l[mom_pos];
  momentary_sum_r -= buf_r[mom_pos];

  // Write new values into ring buffer
  buf_l[buf_pos] = sq_l;
  buf_r[buf_pos] = sq_r;

  // Add new values to sums
  shortterm_sum_l += sq_l;
  shortterm_sum_r += sq_r;
  momentary_sum_l += sq_l;
  momentary_sum_r += sq_r;
  momentary_sum_l < 0 ? momentary_sum_l = 0;
  momentary_sum_r < 0 ? momentary_sum_r = 0;
  shortterm_sum_l < 0 ? shortterm_sum_l = 0;
  shortterm_sum_r < 0 ? shortterm_sum_r = 0;

  // Advance ring buffer position
  buf_pos += 1;
  buf_pos >= buf_size ? buf_pos = 0;

  // --- Integrated loudness: gated 400 ms blocks every 100 ms ---
  sub_acc += sq_l + sq_r;  // channel weights are 1.0 for L/R
  sub_pos += 1;
  sub_pos >= sub_len ? (
    sub_e[sub_idx] = sub_acc / sub_len;
    sub_idx = (sub_idx + 1) % 4;
    sub_filled < 4 ? sub_filled += 1;
    sub_acc = 0;
    sub_pos = 0;
    sub_filled >= 4 ? (
      block_e = (sub_e[0] + sub_e[1] + sub_e[2] + sub_e[3]) / 4;
      block_e > 0 ? (
        block_lufs = -0.691 + 10 * log10(block_e);
        block_lufs > -70 ? (
          bin = floor((block_lufs + 70) * 100);
          bin >= HIST_BINS ? bin = HIST_BINS - 1;
          hist_e[bin] += block_e;
          hist_n[bin] += 1;
          blocks_dirty = 1;
        );
      );
    );
  );

  // --- True peak: 4x polyphase windowed-sinc oversampling ---
  tp_hist_l[tp_hpos] = spl0;
  tp_hist_r[tp_hpos] = spl1;

  tp_l = abs(spl0);
  tp_r = abs(spl1);
  // Phase 0 is the sample 6 back; phases 1..3 sit between it and the next one.
  // (abs of the current sample is checked too, it is phase 0 six samples later)
  ph = 0;
  loop(3,
    acc_l = acc_r = 0;
    k = 0;
    loop(TP_TAPS,
      hi = tp_hpos - k;
      hi < 0 ? hi += TP_TAPS;
      c = tp_coef[ph * TP_TAPS + k];
      acc_l += c * tp_hist_l[hi];
      acc_r += c * tp_hist_r[hi];
      k += 1;
    );
    abs(acc_l) > tp_l ? tp_l = abs(acc_l);
    abs(acc_r) > tp_r ? tp_r = abs(acc_r);
    ph += 1;
  );
  tp_hpos = (tp_hpos + 1) % TP_TAPS;

  tp_l > true_peak_l ? true_peak_l = tp_l;
  tp_r > true_peak_r ? true_peak_r = tp_r;

  sample_count += 1;

  // --- Update gmem every 4096 samples (approx 10x/second at 44.1kHz) ---
  (sample_count % 4096) == 0 ? (
    base = floor(track_slot + 0.5) * 8;

    mom_samples = floor(srate * 0.4);
    mom_samples < 1 ? mom_samples = 1;

    // BS.1770 sums the per-channel mean squares (it does not average channels)
    shortterm_mean = (shortterm_sum_l + shortterm_sum_r) / buf_size;
    momentary_mean = (momentary_sum_l + momentary_sum_r) / mom_samples;

    blocks_dirty ? (
      compute_integrated();
      blocks_dirty = 0;
    );

    // LUFS = -0.691 + 10 * log10(mean_square)
    // Running sums leave float residue in silence; floor at -70 LUFS like integrated
    shortterm_mean > 0 ? (
      shortterm_lufs = -0.691 + 10 * log10(shortterm_mean);
    ) : (
      shortterm_lufs = -70;
    );
    shortterm_lufs < -70 ? shortterm_lufs = -70;

    momentary_mean > 0 ? (
      momentary_lufs = -0.691 + 10 * log10(momentary_mean);
    ) : (
      momentary_lufs = -70;
    );
    momentary_lufs < -70 ? momentary_lufs = -70;


    gmem[base+0] = integrated_lufs;
    gmem[base+1] = shortterm_lufs;
    gmem[base+2] = momentary_lufs;

    true_peak_l > 0.000001 ? (
      gmem[base+3] = 20 * log10(true_peak_l);
    ) : (
      gmem[base+3] = -150;
    );

    true_peak_r > 0.000001 ? (
      gmem[base+4] = 20 * log10(true_peak_r);
    ) : (
      gmem[base+4] = -150;
    );

    gmem[base+5] = sample_count / srate;
  );

  // Pass audio through unmodified
